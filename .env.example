# Copie para .env.local e preencha. NUNCA coloque a service_role key aqui nem em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# local = demonstração em localStorage | supabase = Pessoas, Categorias, Contas e Cartões no Supabase
NEXT_PUBLIC_DATA_SOURCE=local
# Open Finance (opcional, só servidor — NUNCA com NEXT_PUBLIC_): um par por pessoa, do Dashboard da Pluggy.
